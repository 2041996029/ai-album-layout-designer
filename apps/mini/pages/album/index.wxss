page{background:#f7f3eb;color:#272c28;font-family:system-ui,sans-serif}.page{padding:32rpx 28rpx 72rpx}.heading{font-size:42rpx;font-weight:650;margin:16rpx 0 24rpx}.status{padding:24rpx;background:#e8eee6;border-radius:16rpx;line-height:1.7;margin-bottom:24rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx}.section-title{font-size:32rpx;font-weight:600;margin-bottom:24rpx}.muted{font-size:24rpx;color:#687166;line-height:1.8;margin:16rpx 0}.control{padding:22rpx 0}.photo-row{font-size:24rpx;padding:16rpx 0;border-bottom:1rpx solid #eee;display:flex;flex-wrap:wrap;justify-content:space-between}.photo-row>text:first-child{max-width:70%;overflow:hidden;text-overflow:ellipsis}.error{color:#9a442c;width:100%}.warning{color:#875020;background:#fff3de}.candidate,.slot{padding:24rpx 0;border-top:1rpx solid #eee}.mini-spreads{display:flex;flex-wrap:wrap;gap:10rpx;margin:20rpx 0}.mini-spread{padding:20rpx;background:#f7f3eb;font-size:22rpx}.crop{display:flex;gap:12rpx}.crop label{width:24%;font-size:24rpx}input,textarea{background:#f4f5f1;padding:16rpx;border-radius:8rpx;margin:12rpx 0;box-sizing:border-box}textarea{width:100%;height:140rpx}.spread{position:relative;width:100%;aspect-ratio:2/1;overflow:hidden;border:1rpx solid #ddd;margin:20rpx 0}.layer{position:absolute;overflow:hidden;font-size:24rpx}.layer image{width:100%;height:100%}button{margin-top:18rpx;border-radius:16rpx;font-size:28rpx}button[type=primary]{background:#355a46;color:white}
