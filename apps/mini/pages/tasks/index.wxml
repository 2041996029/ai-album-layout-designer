<view class="page"><view class="heading">任务中心</view><view class="muted">离开页面后，后台任务会继续。进度以云端记录为准。</view><view role="status">{{message}}</view><button bindtap="refresh" disabled="{{loading}}">刷新任务</button><view wx:for="{{items}}" wx:key="jobId" class="card"><view>{{item.jobId}}</view><view>{{item.state}}</view></view><view wx:if="{{!items.length && !message && !loading}}" class="muted">暂无任务</view><button wx:if="{{hasMore}}" bindtap="more" disabled="{{loading}}">加载更多</button></view>
