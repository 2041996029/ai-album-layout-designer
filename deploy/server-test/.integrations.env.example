# Copy to .integrations.env on the server only. Never commit the completed file.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=replace-on-server
EMAIL_SMTP_PASSWORD=replace-on-server
EMAIL_FROM=拾光 <noreply@example.com>
EMAIL_ENCRYPTION_SECRET=replace-with-independent-random-secret-at-least-32-characters
WECHAT_MINI_APP_ID=replace-on-server
WECHAT_MINI_APP_SECRET=replace-on-server
# Optional only when the mini app is actually attached to this open-platform scope.
# WECHAT_OPEN_PLATFORM_ID=replace-on-server
# Enable merchant bindings only after preparing the private file and published config.
# ALBUM_PAYMENT_BINDINGS_FILE=/run/album-integrations/payment-bindings.json
# Optional single-server encrypted vault for the existing privileged secret API.
# ALBUM_CONFIG_VAULT_ROOT=/var/lib/album/objects/.config-vault
# ALBUM_CONFIG_VAULT_SECRET=replace-with-another-independent-random-secret-32-characters-or-longer
# ALBUM_CONFIG_DEPENDENCIES_FILE=/run/album-integrations/approved-dependencies.json
