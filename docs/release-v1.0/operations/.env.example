# Local integration template. Application images/files must be built/provisioned before use.
# Do not put real credentials in this file. Production uses secret service and pinned image digests.
APP_ENV=dev
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_API_ORIGIN=http://localhost:3000
HTTP_PORT=3000
TRUST_PROXY_HOPS=1
DATABASE_URL_FILE=/run/secrets/database_url
REDIS_URL_FILE=/run/secrets/redis_url
SESSION_SIGNING_SECRET_FILE=/run/secrets/session_signing
SECRET_STORE_PROVIDER=localFiles
SECRET_STORE_CATALOG_FILE=/run/secrets/catalog.json
CONFIG_REFRESH_SECONDS=30
CONFIG_MAX_STALENESS_SECONDS=300
WORKER_MEMORY_MIB=2048
WORKER_CONCURRENCY=1
LOG_LEVEL=info
LOG_REDACTION=strict
RELEASE_ID=local-review
COMMIT_SHA=
RENDER_BROWSER_REVISION=
API_IMAGE=
WEB_IMAGE=
ADMIN_IMAGE=
WORKER_IMAGE=
POSTGRES_IMAGE=postgres:17
REDIS_IMAGE=redis:7
DATABASE_URL_SECRET_PATH=
REDIS_URL_SECRET_PATH=
SESSION_SECRET_PATH=
SECRET_CATALOG_PATH=
POSTGRES_PASSWORD_PATH=
