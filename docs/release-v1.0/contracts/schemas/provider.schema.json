{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider adapter contract metadata and result states",
  "x-contract-version": "1.0.0",
  "$defs": {
    "root": {
      "type": "object",
      "properties": {
        "adapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "providerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "textToImage",
              "imageToImage",
              "textSuggestion",
              "asyncQuery",
              "cancel",
              "idempotentSubmit"
            ]
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "allowedEndpointHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "minItems": 1,
          "maxItems": 100
        },
        "allowedResultHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "minItems": 1,
          "maxItems": 100
        },
        "supportsModelDiscovery": {
          "type": "boolean"
        },
        "modelLimits": {
          "type": "object",
          "properties": {
            "maxInputBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25000000
            },
            "maxReferenceImages": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "maxOutputPixels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 80000000
            },
            "maxPromptChars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "acceptedMimeTypes": {
              "type": "array",
              "items": {
                "enum": [
                  "image/jpeg",
                  "image/png"
                ]
              },
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true
            }
          },
          "required": [
            "maxInputBytes",
            "maxReferenceImages",
            "maxOutputPixels",
            "maxPromptChars",
            "acceptedMimeTypes"
          ],
          "additionalProperties": false
        },
        "contractTestRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        }
      },
      "required": [
        "adapterId",
        "adapterVersion",
        "providerName",
        "capabilities",
        "allowedEndpointHosts",
        "allowedResultHosts",
        "supportsModelDiscovery",
        "modelLimits",
        "contractTestRef"
      ],
      "additionalProperties": false
    },
    "generationInput": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "modelVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "negativePrompt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "count": {
          "const": 1
        },
        "referenceObjectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 10
        },
        "referenceStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "consentRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        }
      },
      "required": [
        "operationId",
        "modelVersionId",
        "prompt",
        "width",
        "height",
        "count"
      ],
      "additionalProperties": false
    },
    "submitResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "accepted"
            },
            "providerRequestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "acceptedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "format": "date-time"
            }
          },
          "required": [
            "state",
            "providerRequestId",
            "acceptedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "rejected"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "state",
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "unknown"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1800
            }
          },
          "required": [
            "state",
            "operationId",
            "retryAfterSeconds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "queryResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "queued",
                "running",
                "cancel_requested",
                "unknown"
              ]
            },
            "providerRequestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1800
            }
          },
          "required": [
            "state",
            "providerRequestId",
            "retryAfterSeconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "succeeded"
            },
            "providerRequestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "mime": {
                    "enum": [
                      "image/jpeg",
                      "image/png"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "url",
                  "mime"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 1
            },
            "costFen": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "state",
            "providerRequestId",
            "outputs",
            "costFen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "failed",
                "cancelled",
                "rejected"
              ]
            },
            "providerRequestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "state",
            "providerRequestId",
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/root",
  "x-semantic-invariants": [
    "Unknown submission must query original operation/provider ID; not permission to resubmit or switch provider.",
    "Only adapter-whitelisted parameters and endpoint/result hosts; revalidate redirects/DNS; never accept client headers or provider credentials.",
    "Outputs quarantined and validated before moderation/provenance/settlement; model capability and commercial license required."
  ]
}
