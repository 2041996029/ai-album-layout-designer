        "rotation": {
          "type": "number",
          "minimum": -360000,
          "maximum": 360000
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visible": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "fitMode": {
          "enum": [
            "cover",
            "contain"
          ],
          "default": "cover"
        },
        "crop": {
          "$ref": "#/$defs/crop"
