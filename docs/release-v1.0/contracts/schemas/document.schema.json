{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Album Document v1",
  "x-contract-version": "1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "width": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1000000
        },
        "height": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1000000
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "filterRef": {
      "type": "object",
      "properties": {
        "presetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^F(0[1-9]|[12][0-9]|3[0-3])$"
        },
        "recipeVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "presetId",
        "recipeVersion",
        "strength",
        "seed"
      ],
      "additionalProperties": false
    },
    "templateRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
