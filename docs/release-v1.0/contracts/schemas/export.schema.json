{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Export options, immutable snapshot and preflight",
  "x-contract-version": "1.0.0",
  "$defs": {
    "resourceManifest": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "origin": {
                "enum": [
                  "uploaded",
                  "generated",
                  "platform"
                ]
              },
              "variants": {
                "type": "object",
                "properties": {
                  "original": {
                    "type": "object",
                    "properties": {
                      "objectId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                      },
                      "sha256": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "mime": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 80000000
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 80000000
                      }
                    },
                    "required": [
                      "objectId",
                      "sha256",
                      "bytes",
                      "mime"
                    ],
                    "additionalProperties": false
                  },
                  "normalized": {
                    "type": "object",
                    "properties": {
                      "objectId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                      },
                      "sha256": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "mime": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 80000000
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 80000000
                      }
                    },
                    "required": [
                      "objectId",
                      "sha256",
                      "bytes",
                      "mime"
                    ],
                    "additionalProperties": false
                  },
                  "preview": {
                    "type": "object",
                    "properties": {
                      "objectId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                      },
                      "sha256": {
                        "type": "string",
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "mime": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 80000000
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 80000000
                      }
                    },
                    "required": [
                      "objectId",
                      "sha256",
                      "bytes",
                      "mime"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "original",
                  "normalized"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "version",
              "origin",
              "variants"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 500
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              },
              "licenseRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "faceObjectIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                },
                "minItems": 1,
                "maxItems": 1000
              },
              "embeddingAllowed": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "version",
              "sha256",
              "licenseRef",
              "faceObjectIds",
              "embeddingAllowed"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 500
        },
        "templates": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/templateRef"
          },
          "minItems": 0,
          "maxItems": 50
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "presetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "recipeVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "kernelVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "presetId",
              "recipeVersion",
              "kernelVersion",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 33
        }
      },
      "required": [
        "assets",
        "fonts",
        "templates",
        "filters"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "png",
            "jpeg",
            "pdf"
          ]
        },
        "dpi": {
          "enum": [
            72,
            150,
            300
          ]
        },
        "view": {
          "enum": [
            "singlePage",
            "spread"
          ]
        },
        "pageIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_:-]{0,159}$"
          },
          "minItems": 1,
          "maxItems": 102,
          "uniqueItems": true
        },
        "includeCover": {
          "type": "boolean"
        },
        "bleedMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "jpegMatte": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "format",
        "dpi",
        "view",
        "pageIds",
        "includeCover",
        "bleedMm",
        "jpegMatte"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "doc": {
          "$ref": "document.schema.json#/$defs/root"
        },
        "docHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "resources": {
          "$ref": "#/$defs/resourceManifest"
        },
        "options": {
          "$ref": "#/$defs/root"
        },
        "optionsHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshotHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "configReleaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "format": "date-time"
        }
      },
      "required": [
        "snapshotId",
        "projectId",
        "revision",
        "doc",
        "docHash",
        "resources",
        "options",
        "optionsHash",
        "snapshotHash",
        "configReleaseId",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "preflightReport": {
      "type": "object",
      "properties": {
        "snapshotHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "severity": {
                "enum": [
                  "blocker",
                  "warning",
                  "strongWarning"
                ]
              },
              "layerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "surfaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "details": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              }
            },
            "required": [
              "id",
              "code",
              "message",
              "severity"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 5000
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "severity": {
                "enum": [
                  "blocker",
                  "warning",
                  "strongWarning"
                ]
              },
              "layerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              },
              "surfaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "details": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              }
            },
            "required": [
              "id",
              "code",
              "message",
              "severity"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 5000
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "pixelWidth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50000000
              },
              "pixelHeight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50000000
              },
              "trimWidthMm": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 10000
              },
              "trimHeightMm": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 10000
              },
              "bleedMm": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            },
            "required": [
              "id",
              "pixelWidth",
              "pixelHeight",
              "trimWidthMm",
              "trimHeightMm",
              "bleedMm"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 102
        },
        "expiresAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "format": "date-time"
        }
      },
      "required": [
        "snapshotHash",
        "blockers",
        "warnings",
        "surfaces",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/root",
  "x-semantic-invariants": [
    "pageIds match view and document order; includeCover adds only selected cover surfaces; no duplicate surfaces.",
    "Final surface pixelWidth*pixelHeight<=50_000_000; memory budget separately checked; never silently lower DPI.",
    "Snapshot hashes include all resources and options; warning acknowledgements tied to same snapshotHash.",
    "Missing original/font/license, glyph/overflow, unsupported schema/labels are blockers; effectivePPI warnings require explicit acknowledgement."
  ]
}
